PORT=3000

# S3
S3_BUCKET=my-bucket
AWS_REGION=eu-central-1
# Credentials are read by the AWS SDK from the standard chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws, IAM role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: S3-compatible storage (MinIO, R2, ...)
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Optional: CDN / public URL used in API responses
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_KEY_PREFIX=images

# Image processing
UPLOAD_MAX_BYTES=10485760
IMAGE_MAX_DIMENSION=2560
WEBP_QUALITY=80
IMAGE_MAX_INPUT_PIXELS=50000000
